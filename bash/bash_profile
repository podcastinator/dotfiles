# Login shell: set up the environment once, then load interactive settings.

# Homebrew
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"

# Java
[ -d /opt/homebrew/opt/openjdk@11/bin ] && export PATH="/opt/homebrew/opt/openjdk@11/bin:$PATH"

# pyenv
export PYENV_ROOT="$HOME/.pyenv"
[ -d "$PYENV_ROOT/bin" ] && export PATH="$PYENV_ROOT/bin:$PATH"
command -v pyenv >/dev/null && eval "$(pyenv init - bash)"

# Claude Code CLI
export PATH="$HOME/.local/bin:$PATH"

# Machine-specific settings that don't belong in the repo
[ -f "$HOME/.bash_profile.local" ] && source "$HOME/.bash_profile.local"

if [ -f "$HOME/.bashrc" ]; then
        source "$HOME/.bashrc"
fi
